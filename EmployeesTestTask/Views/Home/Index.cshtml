@model IEnumerable<EmployeesTestTask.Models.Employee>

@{
    ViewData["Title"] = "Справочник сотрудников";
    
    // Получаем параметры фильтрации из ViewBag
    var searchName = ViewBag.SearchName as string;
    var isActive = ViewBag.IsActive as bool?;
    var employmentStatus = ViewBag.EmploymentStatus as string ?? "All";
    var page = ViewBag.Page as int? ?? 1;
    var sortBy = ViewBag.SortBy as string ?? "LastName";
    var sortAscending = ViewBag.SortAscending as bool? ?? true;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Справочник сотрудников</h1>
        <div>
            <a href="@Url.Action("Create")" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> Добавить сотрудника
            </a>
            <button type="button" class="btn btn-primary" id="editBtn" disabled>
                <i class="bi bi-pencil"></i> Изменить сотрудника
            </button>
        </div>
    </div>

    <!-- Блок фильтров -->
    <form method="get" action="@Url.Action("Index")" id="filterForm">
        <div class="row mb-3">
            <div class="col-md-3">
                <label for="SearchName" class="form-label">Поиск по ФИО</label>
                <input type="text" class="form-control" id="SearchName" name="searchName" 
                       value="@searchName" placeholder="Введите ФИО">
            </div>
            
            <div class="col-md-3">
                <label for="IsActive" class="form-label">Активность</label>
                <select class="form-select" id="IsActive" name="isActive">
                    <option value="">Все</option>
                    <option value="true" selected="@(isActive == true)">Активные</option>
                    <option value="false" selected="@(isActive == false)">Заблокированные</option>
                </select>
            </div>
            
            <div class="col-md-3">
                <label for="EmploymentStatus" class="form-label">Статус трудоустройства</label>
                <select class="form-select" id="EmploymentStatus" name="employmentStatus">
                    <option value="All" selected="@(employmentStatus == "All")">Все</option>
                    <option value="Employed" selected="@(employmentStatus == "Employed")">Трудоустроенные</option>
                    <option value="Dismissed" selected="@(employmentStatus == "Dismissed")">Уволенные</option>
                </select>
            </div>
            
            <div class="col-md-3 d-flex align-items-end">
                <button type="submit" class="btn btn-primary me-2">Применить фильтр</button>
                <button type="button" class="btn btn-secondary" onclick="clearFilter()">Очистить фильтр</button>
            </div>
        </div>
        
        <!-- Скрытые поля для пагинации и сортировки -->
        <input type="hidden" name="page" id="pageField" value="page" />
        <input type="hidden" name="sortBy" id="sortByField" value="@sortBy" />
        <input type="hidden" name="sortAscending" id="sortAscendingField" value="@sortAscending.ToString()" />
    </form>

    <div class="card">
        <div class="card-header">
            <span>Найдено сотрудников: @totalCount</span>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th><input type="checkbox" id="selectAll"></th>
                            <th>
                                <a href="javascript:void(0)" onclick="sortTable('Id')">ID</a>
                                @if (sortBy == "Id")
                                {
                                    <i class="bi bi-arrow-@(sortAscending ? "up" : "down")"></i>
                                }
                            </th>
                            <th>
                                <a href="javascript:void(0)" onclick="sortTable('LastName')">ФИО</a>
                                @if (sortBy == "LastName")
                                {
                                    <i class="bi bi-arrow-@(sortAscending ? "up" : "down")"></i>
                                }
                            </th>
                            <th>Дата рождения</th>
                            <th>Дата трудоустройства</th>
                            <th>Дата увольнения</th>
                            <th>Активность</th>
                            <th>Дата создания</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employee in Model)
                        {
                            <tr data-employee-id="@employee.Id">
                                <td><input type="checkbox" class="employee-checkbox" value="@employee.Id"></td>
                                <td>@employee.Id</td>
                                <td>@employee.FullName</td>
                                <td>@(employee.DateOfBirth?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td>@employee.CurrentEmploymentStartDate?.ToString("dd.MM.yyyy")</td>
                                <td>@(employee.CurrentEmploymentEndDate?.ToString("dd.MM.yyyy") ?? "—")</td>
                                <td>
                                    <span class="badge @(employee.IsActive ? "bg-success" : "bg-danger")">
                                        @(employee.IsActive ? "Активен" : "Заблокирован")
                                    </span>
                                </td>
                                <td>@employee.CreatedDate.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    <div class="btn-group btn-group-sm">
                                        <a href="@Url.Action("Edit", new { id = employee.Id })" 
                                           class="btn btn-outline-primary">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form method="post" action="@Url.Action("ToggleStatus", new { id = employee.Id })" 
                                              class="d-inline">
                                            <button type="submit" class="btn btn-outline-warning">
                                                <i class="bi @(employee.IsActive ? "bi-lock" : "bi-unlock")"></i>
                                            </button>
                                        </form>
                                        <form method="post" action="@Url.Action("Delete", new { id = employee.Id })" 
                                              class="d-inline" 
                                              onsubmit="return confirm('Вы уверены, что хотите удалить сотрудника?');">
                                            <button type="submit" class="btn btn-outline-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Пагинация -->
            @if (totalPages > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <li class="page-item @(i == page ? "active" : "")">
                                <a class="page-link" href="javascript:void(0)" onclick="goToPage(@i)">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }
        </div>
    </div>
</div>

    <script>
        function clearFilter() {
            document.getElementById('SearchName').value = '';
            document.getElementById('IsActive').selectedIndex = 0;
            document.getElementById('EmploymentStatus').selectedIndex = 0;
            document.getElementById('pageField').value = 1;
            document.getElementById('filterForm').submit();
        }

        function sortTable(column) {
            const currentSortBy = '@sortBy';
            const currentSortAscending = '@sortAscending' === 'True';
            
            let newSortAscending = true;
            if (column === currentSortBy) {
                newSortAscending = !currentSortAscending;
            }
            
            document.getElementById('sortByField').value = column;
            document.getElementById('sortAscendingField').value = newSortAscending;
            document.getElementById('pageField').value = 1;
            document.getElementById('filterForm').submit();
        }

        function goToPage(pageNum) {
            document.getElementById('pageField').value = pageNum;
            document.getElementById('filterForm').submit();
        }

        // Обработка выбора сотрудников
        document.addEventListener('DOMContentLoaded', function() {
            const selectAll = document.getElementById('selectAll');
            const checkboxes = document.querySelectorAll('.employee-checkbox');
            const editBtn = document.getElementById('editBtn');

            selectAll.addEventListener('change', function() {
                checkboxes.forEach(checkbox => {
                    checkbox.checked = selectAll.checked;
                });
                updateEditButton();
            });

            checkboxes.forEach(checkbox => {
                checkbox.addEventListener('change', function() {
                    updateEditButton();
                    updateSelectAll();
                });
            });

            function updateEditButton() {
                const selected = document.querySelectorAll('.employee-checkbox:checked');
                editBtn.disabled = selected.length !== 1;
                
                if (selected.length === 1) {
                    const employeeId = selected[0].value;
                    editBtn.onclick = function() {
                        location.href = '@Url.Action("Edit")' + '?id=' + employeeId;
                    };
                } else {
                    editBtn.onclick = null;
                }
            }

            function updateSelectAll() {
                const allChecked = Array.from(checkboxes).every(checkbox => checkbox.checked);
                const someChecked = Array.from(checkboxes).some(checkbox => checkbox.checked);
                
                selectAll.checked = allChecked;
                selectAll.indeterminate = someChecked && !allChecked;
            }
        });
    </script>
}